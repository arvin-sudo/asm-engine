# Copy this file to .env and fill in the values before running docker compose.
#
# Usage:
#   cp .env.example .env
#   docker compose -f deploy/docker-compose.yaml up

# PostgreSQL password for the asm database user.
POSTGRES_PASSWORD=change_me

# Full DSN used by asm-engine to connect to the database inside the Docker network.
ASM_DB_DSN=postgres://asm:change_me@db/asmdb?sslmode=disable
